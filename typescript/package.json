{
  "name": "gyara",
  "version": "0.1.0",
  "description": "A reliability layer for N-ATLAS: guaranteed structured output and Nigerian-language normalization.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Elvis Preye Kerebi",
  "keywords": ["n-atlas", "nigeria", "llm", "structured-output", "yoruba", "hausa", "igbo"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./normalize": "./dist/normalize/index.js",
    "./structured": "./dist/structured/index.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "zod-to-json-schema": "^3.23.2"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
